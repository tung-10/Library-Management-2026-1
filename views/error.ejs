<%- include('layout/header') %>
<div class="container" style="text-align:center; padding: 80px 20px;">
  <div style="font-size: 5rem; margin-bottom: 20px;">⚠️</div>
  <h1 style="font-size: 2.5rem; color: #c0392b; margin-bottom: 10px;">Lỗi Server</h1>
  <p style="margin-bottom: 30px; color: var(--text-muted);">Đã xảy ra lỗi. Vui lòng thử lại sau.</p>
  <% if (typeof error !== 'undefined' && error) { %>
    <pre style="background:#f4f4f4; padding:20px; border-radius:8px; text-align:left; margin-bottom:20px; overflow-x:auto; font-size:0.85rem;"><%= error.message %></pre>
  <% } %>
  <a href="/" class="btn btn-primary">🏠 Về Trang Chủ</a>
</div>
<%- include('layout/footer') %>
